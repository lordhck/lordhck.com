{% extends "base.j2" %}
{% block title %}#{{ tag }}{% endblock %}
{% block head %}
<meta name="description" content="Posts tagged #{{ tag }}">
<meta name="robots" content="noindex, follow">
<link rel="canonical" href="https://lordhck.com/tags/{{ tag }}">
{% endblock %}
{% block content %}
<article>
<br>
<p>#{{ tag }}</p>
<ul>
{% for post in posts %}
<li class="g">
  <span>
    <span class="d">{{ post.date }}</span>&nbsp;
    <a href="{{ post.url }}">{{ post.title }}</a>
  </span>
  <span>
    &nbsp; {% for t in post.tags %}<a class="tag" href="/tags/{{ t }}">#{{ t }}</a> {% endfor %}
  </span>
</li>
{% endfor %}
</ul>
<p><a href="/"><= index</a></p>
</article>
{% endblock %}
