{% extends "base.j2" %}

{% block content %}
    <section class="about">
        <figure class="about-figure">
            <img class="about-photo" src="/static/imgs/me-openai.webp"
                 alt="Portrait of {{ site.author }}" width="180" height="180">
            <figcaption>How ChatGPT imagines me.</figcaption>
        </figure>

        <div class="about-text">
            <h1>{{ site.author }}</h1>
            <p>
                A self-taught developer and hacker, messing with HTML since the age of 10
                and building things ever since.
            </p>
            <p>
                Mostly working with Linux, Python, web development, networking, servers, 
                containers, and low-level systems.
            </p>
            <p>
                Building things that should exist, automating things that get annoying, 
                and occasionally breaking things just to figure out why they work.
            </p>
            <p>
                Currently deep in vibe-code mode, working on websites, tools, Linux projects, 
                and other weird ideas that probably didn't need to exist.
            </p>
            <p>Stationed in Sweden.</p>
        </div>

        <aside class="hate-list">
            <strong>Things I hate</strong>
            <ul>
                <li>microsoft, outlook</li>
            </ul>
        </aside>
    </section>

{% endblock %}
